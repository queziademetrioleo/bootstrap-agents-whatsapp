# Config de runtime — ambiente DEV.
# Carregado pelo Cloud Run (dev) via Terraform. Nao contem segredos:
# credenciais GCP sao por IAM; credenciais externas vem do Secret Manager.
ENV=dev
LOG_LEVEL=DEBUG
GCP_LOCATION=southamerica-east1
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
RAG_SCORE_THRESHOLD=0.75
RAG_TOP_K=5
SESSION_TTL_SECONDS=3600
SHORT_HISTORY_TURNS=10
MAX_TOOL_ITERATIONS=6
USE_CLOUD_SQL=true
