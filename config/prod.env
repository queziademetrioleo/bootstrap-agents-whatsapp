# Config de runtime — ambiente PROD.
# Carregado pelo Cloud Run (prod) via Terraform. Nao contem segredos.
ENV=prod
LOG_LEVEL=INFO
GCP_LOCATION=southamerica-east1
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
RAG_SCORE_THRESHOLD=0.75
RAG_TOP_K=5
SESSION_TTL_SECONDS=3600
SHORT_HISTORY_TURNS=10
MAX_TOOL_ITERATIONS=6
USE_CLOUD_SQL=true
