# =============================================================================
# WhatsApp AI Agent Bootstrap — variaveis de ambiente
# Copie para `.env` e preencha. Em producao, NADA disso fica em arquivo:
# - credenciais GCP (Vertex, Cloud SQL, Redis) -> resolvidas por IAM/VPC
# - credenciais de APIs externas -> Secret Manager (injetadas pelo Cloud Run)
# =============================================================================

# --- GCP / Vertex AI ---
GCP_PROJECT_ID=meu-projeto-gcp
GCP_LOCATION=southamerica-east1

# Modelo do Gemini via Vertex AI.
# ATENCAO: `gemini-3.5-flash` foi o ID definido no plano. Se a Vertex AI
# retornar 404/NOT_FOUND para esse ID na sua regiao, troque aqui por um ID
# valido (ex.: `gemini-2.5-flash`). E so trocar esta linha — nada no codigo
# fica chumbado no nome do modelo.
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# --- Cloud SQL (PostgreSQL + PgVector) ---
# Em runtime no Cloud Run, use o nome da conexao da instancia:
#   PROJECT:REGION:INSTANCE  (via Cloud SQL Python Connector)
# Para rodar localmente, use DB_HOST/DB_PORT apontando para um Postgres local.
DB_INSTANCE_CONNECTION_NAME=meu-projeto-gcp:southamerica-east1:agent-db
DB_NAME=agent
DB_USER=agent
DB_PASSWORD=troque-em-local-apenas
# Local dev (ignorado quando DB_INSTANCE_CONNECTION_NAME esta setado e USE_CLOUD_SQL=true)
DB_HOST=127.0.0.1
DB_PORT=5432
USE_CLOUD_SQL=true

# --- Redis (Memorystore) ---
REDIS_HOST=10.0.0.3
REDIS_PORT=6379
SESSION_TTL_SECONDS=3600
SHORT_HISTORY_TURNS=10

# --- Pub/Sub ---
PUBSUB_TOPIC=agent-messages
# Verificacao do push do Pub/Sub (OIDC). Email da SA autorizada a invocar o processador.
PUBSUB_PUSH_SA_EMAIL=agent-sa@meu-projeto-gcp.iam.gserviceaccount.com
PUBSUB_AUDIENCE=

# --- Evolution API (WhatsApp) ---
EVOLUTION_BASE_URL=http://10.0.0.2:8080
EVOLUTION_API_KEY=chave-forte-da-evolution
# Segredo compartilhado para validar o HMAC do webhook (ver agent/security.py)
WEBHOOK_HMAC_SECRET=defina-um-segredo-forte

# --- RAG ---
RAG_SCORE_THRESHOLD=0.75
RAG_TOP_K=5

# --- Debounce / agrupamento de mensagens em bolhas ---
# Janela de silencio (s) para juntar mensagens quebradas. 0 desabilita.
DEBOUNCE_SECONDS=8
DEBOUNCE_BUFFER_TTL_SECONDS=300

# --- Agente / runtime ---
DEFAULT_AGENT_ID=default
MAX_TOOL_ITERATIONS=6
ENV=dev
LOG_LEVEL=INFO
